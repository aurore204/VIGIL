{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "vigil",
  "version": "0.1.0",
  "identifier": "com.epitech.vigil",
  "build": {
    "frontendDist": "../../client_web/out",
    "devUrl": "http://localhost:3005",
    "beforeDevCommand": "cd ../client_web && npm run dev -- -p 3005",
    "beforeBuildCommand": "cd ../../client_web && npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "VIGIL",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
   "plugins": {
    "notification": {}
  }
}
