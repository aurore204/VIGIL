  "query": "\n        UPDATE release_steps\n        SET\n            state = 'completed',\n            validated_by = $1,\n            validated_at = NOW(),\n            updated_at = NOW()\n        WHERE id = $2\n        RETURNING\n            id, release_id, validated_by, name, description, position,\n            state as \"state: StepState\",\n            validated_at, created_at, updated_at\n        ",
