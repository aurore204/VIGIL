  "query": "\n        INSERT INTO private_messages (sender_id, receiver_id, content)\n        VALUES ($1, $2, $3)\n        RETURNING\n            id,\n            sender_id,\n            (SELECT username FROM users WHERE id = sender_id) as \"sender_username!\",\n            receiver_id,\n            (SELECT username FROM users WHERE id = receiver_id) as \"receiver_username!\",\n            content,\n            read_at,\n            created_at\n        ",
