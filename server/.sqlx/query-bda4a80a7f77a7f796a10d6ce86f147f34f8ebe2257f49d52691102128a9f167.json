  "query": "\n        INSERT INTO incident_timeline (incident_id, author_id, content)\n        VALUES ($1, $2, $3)\n        RETURNING\n            id,\n            incident_id,\n            author_id,\n            (SELECT username FROM users WHERE id = author_id) as \"author_username!\",\n            content,\n            edited_at,\n            created_at\n        ",
