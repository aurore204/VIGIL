  "query": "\n        SELECT\n            id, team_id, created_by, name, enabled,\n            trigger, reaction, created_at, updated_at\n        FROM rules\n        WHERE team_id = $1\n          AND enabled = true\n          AND trigger->>'service' = $2\n          AND trigger->>'event' = $3\n        ",
