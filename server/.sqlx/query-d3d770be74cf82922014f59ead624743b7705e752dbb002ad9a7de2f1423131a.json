  "query": "\n        UPDATE teams\n        SET\n            name = COALESCE($1, name),\n            description = COALESCE($2, description),\n            updated_at = NOW()\n        WHERE id = $3\n        RETURNING id, name, description, manager_id, created_at, updated_at\n        ",
