  "query": "\n        SELECT \n            tm.user_id,\n            u.username,\n            u.email,\n            tm.role as \"role: TeamRole\",\n            tm.joined_at\n        FROM team_members tm\n        JOIN users u ON u.id = tm.user_id\n        WHERE tm.team_id = $1\n        ",
