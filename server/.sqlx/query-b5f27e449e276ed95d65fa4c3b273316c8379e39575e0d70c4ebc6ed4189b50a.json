  "query": "\n        UPDATE incident_timeline\n        SET content = $1, edited_at = NOW()\n        WHERE id = $2\n        RETURNING\n            id,\n            incident_id,\n            author_id,\n            (SELECT username FROM users WHERE id = author_id) as \"author_username!\",\n            content,\n            edited_at,\n            created_at\n        ",
