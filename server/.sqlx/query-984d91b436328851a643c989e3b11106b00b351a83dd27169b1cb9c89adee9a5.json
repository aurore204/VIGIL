{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            tb.user_id,\n            u.username,\n            u.email,\n            tb.banned_by,\n            banner.username as banned_by_username,\n            tb.expires_at,\n            tb.reason,\n            tb.created_at\n        FROM team_bans tb\n        JOIN users u ON u.id = tb.user_id\n        JOIN users banner ON banner.id = tb.banned_by\n        WHERE tb.team_id = $1\n        AND (tb.expires_at IS NULL OR tb.expires_at > NOW())\n        ORDER BY tb.created_at DESC\n        ",
