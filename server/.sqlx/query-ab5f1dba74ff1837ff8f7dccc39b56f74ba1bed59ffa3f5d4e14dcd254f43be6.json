  "query": "\n        UPDATE users\n        SET\n          username = COALESCE($1, username),\n          email = COALESCE($2, email),\n          password_hash = COALESCE($3, password_hash),\n          language = COALESCE($4, language),\n          updated_at = now()\n        WHERE id = $5\n        RETURNING id, email, username, language, created_at\n        ",
